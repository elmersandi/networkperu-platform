// =====================================================================
// 1. CONFIGURACIÓN PRINCIPAL
// =====================================================================
generator client { // Define el motor que generará el código para interactuar con la BD
  provider = "prisma-client" // Usamos el cliente oficial de Prisma para JavaScript/TypeScript
  output   = "../src/app/generated/prisma" // Ruta donde se guardará el cliente generado
}

datasource db { // Define a qué base de datos nos vamos a conectar
  provider = "postgresql" // Indicamos que el motor de base de datos es PostgreSQL (Neon DB)
  url      = env("DATABASE_URL") // Jala la URL de conexión segura desde tu archivo .env
}

// =====================================================================
// 2. LISTAS FIJAS (ENUMS)
// =====================================================================
enum TipoCategoria { // Crea una lista de opciones estrictas para no equivocarnos al teclear
  PRODUCTO  // Etiqueta para clasificar todo lo que sea hardware físico
  SERVICIO  // Etiqueta para clasificar instalaciones, soporte o mano de obra
}

// =====================================================================
// 3. MÓDULO DE AUTENTICACIÓN Y SEGURIDAD
// =====================================================================
model Usuario { // Define la tabla donde se guardan los administradores del panel
  id               String    @id @default(cuid()) // Llave principal (ID) única, corta y segura
  email            String    @unique // Correo corporativo (No permite correos duplicados)
  password         String // Guarda la contraseña ya encriptada (nunca en texto plano)
  nombre           String    @default("Administrador") // Nombre del admin, con valor por defecto
  imagen           String? // Enlace a su foto de perfil (El signo '?' significa que es opcional)
  resetToken       String?   @unique // Código encriptado temporal para recuperar la clave
  resetTokenExpiry DateTime? // Fecha y hora exacta en la que el token dejará de funcionar
  createdAt        DateTime  @default(now()) // Guarda automáticamente la fecha en que se registró
  updatedAt        DateTime  @updatedAt // Se actualiza solo cada vez que modificas al usuario
}

model CodigoVerificacion { // Tabla temporal para los códigos OTP de 6 dígitos
  id        String   @id @default(cuid()) // ID único del registro del código
  email     String // Correo al que se le envió el código de seguridad
  codigo    String // El número de 6 dígitos que el usuario debe escribir
  expiraEn  DateTime // El minuto exacto en que el código se vuelve inservible
  createdAt DateTime @default(now()) // Fecha y hora en que se generó este código

  @@unique([email, codigo]) // Regla: Un mismo correo no puede tener el mismo código activo a la vez
  @@index([email]) // Índice para encontrar y borrar rápidamente los códigos de un correo
}

// =====================================================================
// 4. MÓDULO DE INVENTARIO Y CATÁLOGO
// =====================================================================
model Categoria { // Tabla de categorías principales (Padres)
  id            String         @id @default(cuid()) // ID único de la categoría
  nombre        String         @unique // Nombre visible (Ej: "Cámaras de Seguridad")
  slug          String         @unique // Nombre en minúsculas y con guiones para la URL de la web
  tipo          TipoCategoria // Selecciona si esta categoría pertenece a PRODUCTO o SERVICIO
  descripcion   String? // Texto opcional para describir qué hay en esta categoría
  subcategorias Subcategoria[] // Relación: Una categoría puede tener muchas subcategorías adentro
  createdAt     DateTime       @default(now()) // Fecha de creación
  updatedAt     DateTime       @updatedAt // Fecha de última edición

  @@index([tipo]) // Índice para filtrar súper rápido entre "Solo Productos" o "Solo Servicios"
}

model Subcategoria { // Tabla de clasificaciones secundarias (Hijas)
  id          String     @id @default(cuid()) // ID único de la subcategoría
  nombre      String // Nombre visible (Ej: "Cámaras IP")
  slug        String     @unique // Texto para la URL (Ej: "camaras-ip")
  categoriaId String // ID de la Categoría Padre a la que pertenece
  
  // Relación con protección: Impide borrar la Categoría Padre si aún tiene Subcategorías adentro
  categoria   Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  
  productos   Producto[] // Relación: Esta subcategoría contiene muchos productos
  servicios   Servicio[] // Relación: Esta subcategoría contiene muchos servicios

  @@index([categoriaId]) // Índice para cargar al instante las subcategorías de un padre específico
}

model Producto { // Tabla del inventario físico (Equipos y Hardware)
  id              String       @id @default(cuid()) // ID único en la base de datos
  sku             String       @unique // Código de barras o identificador único comercial
  nombre          String // Nombre del producto (Ej: "Router MikroTik...")
  slug            String       @unique // URL amigable del producto
  descripcion     String       @db.Text // Texto largo para la ficha técnica completa
  precio          Float // Precio de venta con decimales
  stock           Int          @default(0) // Cantidad de unidades disponibles en almacén
  imagenPrincipal String? // Enlace a la foto de portada del producto
  galeria         String[] // Lista (array) con enlaces a más fotos del producto
  isActivo        Boolean      @default(true) // Switch para apagar o prender el producto en la web
  subcategoriaId  String // ID de la subcategoría a la que pertenece
  
  // Relación con protección: Impide borrar la Subcategoría si hay productos asociados a ella
  subcategoria    Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  
  createdAt       DateTime     @default(now()) // Fecha en que ingresó al sistema
  updatedAt       DateTime     @updatedAt // Fecha de su última actualización de precio o stock

  @@index([nombre]) // Índice para que el buscador en tiempo real vuele al teclear el nombre
  @@index([subcategoriaId, isActivo]) // Índice doble para filtrar catálogos de la web al instante
}

model Servicio { // Tabla del catálogo de servicios (Mano de obra, instalaciones)
  id              String       @id @default(cuid()) // ID único del servicio
  nombre          String // Título del servicio (Ej: "Certificación de Fibra")
  slug            String       @unique // URL amigable
  descripcion     String       @db.Text // Detalles completos de qué incluye el trabajo
  precioBase      Float // Tarifa mínima o precio "desde"
  portada         String? // Imagen principal para publicitar el servicio
  galeria         String[] // Lista de fotos de trabajos anteriores similares
  videoUrl        String? // Link a un video explicativo en YouTube
  isActivo        Boolean      @default(true) // Switch para mostrar/ocultar el servicio en la web
  subcategoriaId  String // ID de la subcategoría de servicios
  
  // Relación con protección: Impide borrar clasificaciones en uso
  subcategoria    Subcategoria @relation(fields: [subcategoriaId], references: [id], onDelete: Restrict)
  
  createdAt       DateTime     @default(now()) // Fecha en que se creó el servicio
  updatedAt       DateTime     @updatedAt // Fecha de última actualización

  @@index([nombre]) // Índice rápido para el buscador del panel
  @@index([subcategoriaId, isActivo]) // Índice rápido para cargar la grilla de la página web
}

// =====================================================================
// 5. MÓDULO DE CONFIGURACIÓN GLOBAL (Sitio Web)
// =====================================================================
model ConfiguracionWeb { // Tabla para controlar los textos y datos de contacto de la web pública
  id                 String   @id @default("1") // Se fuerza siempre al ID "1" para tener una sola fila
  
  nombreEmpresa      String // Nombre comercial corto
  razonSocial        String? // Nombre legal completo para facturación
  ruc                String? // Número de RUC de la empresa
  tituloSitio        String // Título que sale en la pestaña del navegador web
  descripcionSeo     String?  @db.Text // Texto oculto para que Google entienda de qué trata la web
  faviconUrl         String? // Link al ícono chiquito de la pestaña
  logoUrl            String? // Link al logo grande de la cabecera
  whatsapp           String // Número de celular para el botón de WhatsApp
  emailCotizacion    String // Correo donde llegan las solicitudes de clientes
  emailPersonal      String? // Correo secundario o personal
  telefonoPrincipal  String // Teléfono fijo o celular principal
  telefonoSecundario String? // Teléfono alternativo opcional
  direccion          String // Dirección física de la oficina
  horarioAtencion    String? // Texto libre (Ej: Lunes a Viernes 9am - 6pm)
  mapaUrl            String?  @db.Text // Código iframe para incrustar Google Maps
  facebook           String? // Link al perfil de Facebook
  instagram          String? // Link al perfil de Instagram
  linkedin           String? // Link al perfil de LinkedIn
  youtube            String? // Link al canal de YouTube
  tiktok             String? // Link al perfil de TikTok
  mision             String   @db.Text // Texto corporativo de Misión
  vision             String   @db.Text // Texto corporativo de Visión
  heroTitulo         String // Título principal gigante del banner de la web
  heroSubtitulo      String // Texto debajo del título principal
  textoFooter        String?  @db.Text // Mensaje de derechos reservados o frase en el pie de página
  
  updatedAt          DateTime @updatedAt // Registra cuándo se modificó la web por última vez
}